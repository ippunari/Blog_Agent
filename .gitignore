# 비밀 정보 (rules/common.md 7장: API 키는 리포에 넣지 않는다)
.env
.env.*
*.key
*.pem
credentials*.json
.claude/settings.local.json

# macOS
.DS_Store

# 작업 데이터 — git에는 프로그램·규칙·폴더 구조만 (D42). 파일은 로컬 폴더에만
candidates/*
!candidates/.gitkeep
topics/*
!topics/.gitkeep
briefs/*
!briefs/.gitkeep
research/*
!research/.gitkeep
drafts/*
!drafts/.gitkeep
factcheck/*
!factcheck/.gitkeep
reports/*
!reports/.gitkeep
